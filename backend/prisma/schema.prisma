generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FARMER
  CUSTOMER
  SUPPLIER
  ADMIN
}

enum ProductStatus {
  AVAILABLE
  OUT_OF_STOCK
  HIDDEN
}

enum CropStatus {
  ACTIVE
  HARVESTED
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CASH
}

enum ReminderType {
  IRRIGATION
  FERTILIZATION
  OTHER
}

model User {
  id                     String    @id @default(uuid()) @db.Uuid
  fullName               String    @map("full_name") @db.VarChar(100)
  email                  String    @unique @db.VarChar(100)
  password               String    @db.VarChar(255)
  phone                  String?   @db.VarChar(20)
  role                   UserRole
  address                String?
  profileImage           String?   @map("profile_image")
  isActive               Boolean   @default(true) @map("is_active")
  resetPasswordToken     String?   @map("reset_password_token")
  resetPasswordExpiresAt DateTime? @map("reset_password_expires_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  products        Product[]
  crops           Crop[]
  diagnoses       Diagnosis[]
  orders          Order[]
  reviews         Review[]
  favorites       Favorite[]
  reminders       Reminder[]
  notifications   Notification[]
  aiMarketingLogs AIMarketingLog[]
  pushDevices     PushDevice[]

  supplierProducts   SupplierProduct[] @relation("SupplierProducts")
  supplierOrders     SupplierOrder[]   @relation("SupplierOrders")
  farmerSupplyOrders SupplierOrder[]   @relation("FarmerSupplyOrders")

  @@map("users")
}

model PushDevice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

model Category {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  description   String?
  nameEn        String?  @map("name_en") @db.VarChar(100)
  nameAr        String?  @map("name_ar") @db.VarChar(100)
  descriptionEn String?  @map("description_en")
  descriptionAr String?  @map("description_ar")
  createdAt     DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id         String @id @default(uuid()) @db.Uuid
  farmerId   String @map("farmer_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  name        String  @db.VarChar(150)
  description String?

  nameEn        String? @map("name_en") @db.VarChar(150)
  nameAr        String? @map("name_ar") @db.VarChar(150)
  descriptionEn String? @map("description_en")
  descriptionAr String? @map("description_ar")

  price     Decimal       @db.Decimal(10, 2)
  quantity  Decimal       @db.Decimal(12, 3)
  unit      String        @db.VarChar(30)
  imageUrl  String?       @map("image_url")
  status    ProductStatus @default(AVAILABLE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  farmer          User             @relation(fields: [farmerId], references: [id])
  category        Category         @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
  reviews         Review[]
  favorites       Favorite[]
  aiMarketingLogs AIMarketingLog[]

  @@map("products")
}

model SupplierCategory {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  description   String?
  nameEn        String?  @map("name_en") @db.VarChar(100)
  nameAr        String?  @map("name_ar") @db.VarChar(100)
  descriptionEn String?  @map("description_en")
  descriptionAr String?  @map("description_ar")
  createdAt     DateTime @default(now()) @map("created_at")

  products SupplierProduct[]

  @@map("supplier_categories")
}

model SupplierProduct {
  id         String @id @default(uuid()) @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  name        String  @db.VarChar(150)
  description String?

  nameEn        String? @map("name_en") @db.VarChar(150)
  nameAr        String? @map("name_ar") @db.VarChar(150)
  descriptionEn String? @map("description_en")
  descriptionAr String? @map("description_ar")

  plantingInstructions   String? @map("planting_instructions")
  plantingInstructionsEn String? @map("planting_instructions_en")
  plantingInstructionsAr String? @map("planting_instructions_ar")

  irrigationInstructions   String? @map("irrigation_instructions")
  irrigationInstructionsEn String? @map("irrigation_instructions_en")
  irrigationInstructionsAr String? @map("irrigation_instructions_ar")

  usageInstructions   String? @map("usage_instructions")
  usageInstructionsEn String? @map("usage_instructions_en")
  usageInstructionsAr String? @map("usage_instructions_ar")

  price     Decimal       @db.Decimal(10, 2)
  quantity  Int
  unit      String        @db.VarChar(30)
  imageUrl  String?       @map("image_url")
  status    ProductStatus @default(AVAILABLE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  supplier   User                @relation("SupplierProducts", fields: [supplierId], references: [id])
  category   SupplierCategory    @relation(fields: [categoryId], references: [id])
  orderItems SupplierOrderItem[]

  @@index([supplierId])
  @@index([categoryId])
  @@map("supplier_products")
}

model SupplierOrder {
  id              String         @id @default(uuid()) @db.Uuid
  farmerId        String         @map("farmer_id") @db.Uuid
  supplierId      String         @map("supplier_id") @db.Uuid
  totalPrice      Decimal        @map("total_price") @db.Decimal(10, 2)
  status          OrderStatus    @default(PENDING)
  deliveryMethod  DeliveryMethod @map("delivery_method")
  paymentMethod   PaymentMethod  @default(CASH) @map("payment_method")
  deliveryAddress String?        @map("delivery_address")
  pickupLocation  String?        @map("pickup_location")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  farmer     User                @relation("FarmerSupplyOrders", fields: [farmerId], references: [id])
  supplier   User                @relation("SupplierOrders", fields: [supplierId], references: [id])
  orderItems SupplierOrderItem[]

  @@index([farmerId])
  @@index([supplierId])
  @@map("supplier_orders")
}

model SupplierOrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   SupplierOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product SupplierProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("supplier_order_items")
}

model Crop {
  id       String @id @default(uuid()) @db.Uuid
  farmerId String @map("farmer_id") @db.Uuid

  cropName String  @map("crop_name") @db.VarChar(100)
  cropType String? @map("crop_type") @db.VarChar(100)

  cropNameEn String? @map("crop_name_en") @db.VarChar(100)
  cropNameAr String? @map("crop_name_ar") @db.VarChar(100)

  cropTypeEn String? @map("crop_type_en") @db.VarChar(100)
  cropTypeAr String? @map("crop_type_ar") @db.VarChar(100)

  plantingDate DateTime? @map("planting_date") @db.Date

  area     Decimal? @db.Decimal(10, 2)
  areaUnit String?  @map("area_unit") @db.VarChar(20)

  expectedYieldMin Decimal? @map("expected_yield_min") @db.Decimal(10, 2)
  expectedYieldMax Decimal? @map("expected_yield_max") @db.Decimal(10, 2)
  yieldUnit        String?  @map("yield_unit") @db.VarChar(20)
  yieldConfidence  String?  @map("yield_confidence") @db.VarChar(20)

  irrigationSchedule   String? @map("irrigation_schedule")
  irrigationScheduleEn String? @map("irrigation_schedule_en")
  irrigationScheduleAr String? @map("irrigation_schedule_ar")

  fertilizationSchedule   String? @map("fertilization_schedule")
  fertilizationScheduleEn String? @map("fertilization_schedule_en")
  fertilizationScheduleAr String? @map("fertilization_schedule_ar")

  sprayingSchedule   String? @map("spraying_schedule")
  sprayingScheduleEn String? @map("spraying_schedule_en")
  sprayingScheduleAr String? @map("spraying_schedule_ar")

  notes   String?
  notesEn String? @map("notes_en")
  notesAr String? @map("notes_ar")

  status    CropStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  farmer    User        @relation(fields: [farmerId], references: [id])
  diagnoses Diagnosis[]
  reminders Reminder[]

  @@map("crops")
}

model Diagnosis {
  id       String  @id @default(uuid()) @db.Uuid
  farmerId String  @map("farmer_id") @db.Uuid
  cropId   String? @map("crop_id") @db.Uuid

  plantName   String? @map("plant_name") @db.VarChar(150)
  plantNameEn String? @map("plant_name_en") @db.VarChar(150)
  plantNameAr String? @map("plant_name_ar") @db.VarChar(150)

  imageUrl String @map("image_url")

  diseaseName   String? @map("disease_name") @db.VarChar(150)
  diseaseNameEn String? @map("disease_name_en") @db.VarChar(150)
  diseaseNameAr String? @map("disease_name_ar") @db.VarChar(150)

  confidence Decimal? @db.Decimal(5, 2)

  isPlant           Boolean? @map("is_plant")
  isImageClear      Boolean? @map("is_image_clear")
  isHealthy         Boolean? @map("is_healthy")
  severity          String?  @db.VarChar(30)
  visibleSymptoms   String?  @map("visible_symptoms")
  needsExpertReview Boolean? @map("needs_expert_review")

  visibleSymptomsEn String? @map("visible_symptoms_en")
  visibleSymptomsAr String? @map("visible_symptoms_ar")

  description   String?
  descriptionEn String? @map("description_en")
  descriptionAr String? @map("description_ar")

  causes   String?
  causesEn String? @map("causes_en")
  causesAr String? @map("causes_ar")

  treatment   String?
  treatmentEn String? @map("treatment_en")
  treatmentAr String? @map("treatment_ar")

  prevention   String?
  preventionEn String? @map("prevention_en")
  preventionAr String? @map("prevention_ar")

  createdAt DateTime @default(now()) @map("created_at")

  farmer        User           @relation(fields: [farmerId], references: [id])
  crop          Crop?          @relation(fields: [cropId], references: [id])
  notifications Notification[]

  @@map("diagnoses")
}

model Order {
  id              String         @id @default(uuid()) @db.Uuid
  customerId      String         @map("customer_id") @db.Uuid
  totalPrice      Decimal        @map("total_price") @db.Decimal(10, 2)
  status          OrderStatus    @default(PENDING)
  deliveryMethod  DeliveryMethod @map("delivery_method")
  paymentMethod   PaymentMethod  @default(CASH) @map("payment_method")
  deliveryAddress String?        @map("delivery_address")
  pickupLocation  String?        @map("pickup_location")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  customer   User        @relation(fields: [customerId], references: [id])
  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Decimal @db.Decimal(12, 3)
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  customer User    @relation(fields: [customerId], references: [id])
  product  Product @relation(fields: [productId], references: [id])

  @@map("reviews")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  customer User    @relation(fields: [customerId], references: [id])
  product  Product @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
  @@map("favorites")
}

model Reminder {
  id       String @id @default(uuid()) @db.Uuid
  farmerId String @map("farmer_id") @db.Uuid

  title   String? @db.VarChar(100)
  titleEn String? @map("title_en") @db.VarChar(100)
  titleAr String? @map("title_ar") @db.VarChar(100)

  cropName   String? @map("crop_name") @db.VarChar(100)
  cropNameEn String? @map("crop_name_en") @db.VarChar(100)
  cropNameAr String? @map("crop_name_ar") @db.VarChar(100)

  cropId String? @map("crop_id") @db.Uuid

  type ReminderType @default(OTHER)

  reminderDate       DateTime  @map("reminder_date")
  repeatDays         Int[]     @default([]) @map("repeat_days")
  status             Boolean   @default(false)
  notificationSentAt DateTime? @map("notification_sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  farmer User  @relation(fields: [farmerId], references: [id])
  crop   Crop? @relation(fields: [cropId], references: [id])

  @@map("reminders")
}

model Notification {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  diagnosisId String? @map("diagnosis_id") @db.Uuid

  title   String @db.VarChar(150)
  message String

  titleEn String? @map("title_en") @db.VarChar(150)
  titleAr String? @map("title_ar") @db.VarChar(150)

  messageEn String? @map("message_en")
  messageAr String? @map("message_ar")

  type      String?  @db.VarChar(50)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id])
  diagnosis Diagnosis? @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model AIMarketingLog {
  id                   String   @id @default(uuid()) @db.Uuid
  farmerId             String   @map("farmer_id") @db.Uuid
  productId            String?  @map("product_id") @db.Uuid
  inputText            String   @map("input_text")
  generatedTitle       String?  @map("generated_title")
  generatedDescription String?  @map("generated_description")
  generatedKeywords    String?  @map("generated_keywords")
  suggestions          String?
  createdAt            DateTime @default(now()) @map("created_at")

  farmer  User     @relation(fields: [farmerId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@map("ai_marketing_logs")
}
